# ============================================================
#  DataWhisper — .gitignore
#
#  仓库结构：`desktop/`（Go + MyGo 桌面端）、`server/`（Bun/TS 服务）、
#  `compute/`（Python 计算进程）、`Function/`（计算实现）、`static/vendor/`（图表 JS）。
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.python-version

# ---- 构建产物 ----
node_modules/
build/
dist/
*.spec
*.egg-info/
.eggs/

# 随包的可执行文件由 scripts/build/*.sh 生成，不入库（每个约 100 MB）。
desktop/resources/*/bin/
# 随包的图表静态库（plotly/echarts/d3）同样由 bundle-static.sh 复制，不入库。
desktop/resources/*/static/

# ---- 运行期数据与缓存 ----
outputs/
uploads/
tmp/
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.deps_installed
.session_tmps/

# 本地凭据与配置（绝不入库）
.env
.env.local
*.local
secret_key
config/hooks.json
config/hooks-history.json
config/feishu-bot.json
*.sqlite-shm
*.sqlite-wal

# ---- 文档与脚本 ----
docs/*
!/docs/refactor/
docs/refactor/*.png
# 打包与构建脚本显式保留（scripts/* 默认忽略）。
scripts/*
!scripts/build/
!scripts/build/**

# ---- 编辑器与系统 ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- 本地实验 ----
.claude
.agents/
.uploads/
/memory/
Test/
.pnpm-store/
